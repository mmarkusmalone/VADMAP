import csv

input_file = "data_labeling/src/components/data/vad_data.csv"
output_file = "data_labeling/src/components/data/vad_data_transformed.csv"

with open(input_file, newline='', encoding='utf-8') as infile, \
     open(output_file, 'w', newline='', encoding='utf-8') as outfile:
    reader = csv.reader(infile)
    writer = csv.writer(outfile)
    writer.writerow(['V', 'A', 'D', 'text'])
    next(reader)
    for row in reader:
        if len(row) < 4:
            continue  # skip malformed lines
        text, v, a, d = row[0], float(row[1]), float(row[2]), float(row[3])
        v_new = (v + 1) / 2
        a_new = (a + 1) / 2
        d_new = (d + 1) / 2
        writer.writerow([round(v_new, 3), round(a_new, 3), round(d_new, 3), text])